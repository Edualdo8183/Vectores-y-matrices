Ejercicio 1
import numpy as np

filas = int(input("Ingrese el número de productos: "))
inventario = []

for i in range(filas):
    precio = float(input(f"Ingrese el precio por unidad del producto {i + 1}: "))
    cantidad = int(input(f"Ingrese la cantidad en stock del producto {i + 1}: "))
    inventario.append([precio, cantidad])

inventario = np.array(inventario)
valores_por_producto = inventario[:, 0] * inventario[:, 1]
valor_total = np.sum(valores_por_producto)

print(valores_por_producto)
print(valor_total)

Ejercicio 2:
import numpy as np

filas = int(input("Ingrese el número de tiendas: "))
columnas = int(input("Ingrese el número de días: "))

ventas = []
for i in range(filas):
    print(f"Ingrese las ventas para la tienda {i + 1} (separadas por espacio):")
    fila = list(map(int, input().split()))
    ventas.append(fila)

matriz_ventas = np.array(ventas)
ventas_por_tienda = np.sum(matriz_ventas, axis=1)
indice_mayor_tienda = np.argmax(ventas_por_tienda)
ventas_por_dia = np.sum(matriz_ventas, axis=0)
indice_mayor_dia = np.argmax(ventas_por_dia)

print("\nResultados:")
print("Ventas totales por tienda:", ventas_por_tienda.tolist())
print(f"La tienda con mayores ventas es la tienda {indice_mayor_tienda + 1} (índice {indice_mayor_tienda}).")
print(f"El día con mayores ventas es el día {indice_mayor_dia + 1} (índice {indice_mayor_dia}).")

Ejercicio 3:
import numpy as np

n = int(input("¿Cuántos productos deseas ingresar? "))

datos = []

for i in range(n):
    precio = float(input(f"Ingrese el precio del producto {i + 1}: "))
    descuento = float(input(f"Ingrese el descuento (%) del producto {i + 1}: "))
    datos.append([precio, descuento])

precios = np.array(datos)
precios_finales = precios[:, 0] * (1 - precios[:, 1] / 100)

print("Finales =", precios_finales.tolist())

Ejercicio 4:
import numpy as np

filas = int(input("Ingresa el número de sucursales: "))
columnas = int(input("Ingresa el número de trimestres: "))

ganancias = []
for i in range(filas):
    fila = list(map(int, input(f"Sucursal {i+1}: ").split()))
    while len(fila) != columnas:
        print(f"Debes ingresar exactamente {columnas} valores.")
        fila = list(map(int, input(f"Sucursal {i+1}: ").split()))
    ganancias.append(fila)

ganancias = np.array(ganancias)

totales_anuales = np.sum(ganancias, axis=1)
totales_trimestre = np.sum(ganancias, axis=0)
indice_mayor_ganancia = np.argmax(totales_anuales) + 1

print("\nResultados:")
print("Totales anuales:", totales_anuales)
print("Totales por trimestre:", totales_trimestre)
print("Sucursal con mayores ganancias:", indice_mayor_ganancia) 


